{
	"name": "commity",
	"displayName": "Commity",
	"description": "AI-powered commit message generator",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"SCM Providers"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"extensionDependencies": [
		"vscode.git"
	],
	"contributes": {
		"commands": [
			{
				"command": "commity.generateCommitMessage",
				"title": "Generate Commity Message",
				"icon": "$(robot)"
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "commity.generateCommitMessage",
					"group": "navigation",
					"when": "scmProvider == git"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "20.x",
		"@types/vscode": "^1.80.0",
		"@typescript-eslint/eslint-plugin": "^6.4.1",
		"@typescript-eslint/parser": "^6.4.1",
		"eslint": "^8.47.0",
		"jest": "^30.2.0",
		"prettier": "^3.6.2",
		"ts-jest": "^29.4.5",
		"typescript": "^5.1.6"
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"js-yaml": "^4.1.0",
		"openai": "^4.75.0",
		"zod": "^3.23.8"
	},
	"packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
